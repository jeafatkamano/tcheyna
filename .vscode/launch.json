{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },

        {
            "command": "npm start",
            "name": "Run npm start",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Debug",
            "type": "comet",
            "request": "launch",
            "preLaunchTask": "comet: Build"
        }
    ]
}